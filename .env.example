# Copie ce fichier en .env (developpement) ou configure ces variables sur ton
# hebergeur (production). Aucune valeur ici n'est un vrai secret.

# --- Coeur de l'application ---------------------------------------------
APP_URL=http://localhost:3000
# Genere avec : npm run gen:secret
SESSION_SECRET=

# --- Base de donnees -------------------------------------------------------
# Local (par defaut) : fichier SQLite.
DATABASE_URL=file:./data/app.db
# Production recommandee : Turso (libsql distribue).
# DATABASE_URL=libsql://ton-projet.turso.io
# DATABASE_AUTH_TOKEN=

# --- Produit -----------------------------------------------------------
PRICE_XOF=5000
MERCHANT_NAME=Nosbe Trade
SUPPORT_WHATSAPP=+22606726239

# --- Comptes admin (back-office) ----------------------------------------
# Numeros au format international, separes par des virgules.
ADMIN_PHONES=+22606726239

# Second facteur pour /admin, en plus du telephone. IMPORTANT : a definir des
# que ADMIN_PHONES sert aussi de numero de paiement manuel affiche aux
# clients (cas frequent) — sinon toute personne connaissant ce numero connait
# aussi le numero qui, seul, ouvrirait le back-office. Genere avec :
# npm run gen:secret
ADMIN_ACCESS_CODE=

# Webhook appele quand une commande manuelle attend une validation (colle
# directement une URL de webhook entrant Slack ou Discord, ou n'importe quel
# endpoint qui accepte du JSON en POST). Vide = notification en log serveur uniquement.
ADMIN_NOTIFY_URL=
ADMIN_NOTIFY_TOKEN=

# --- Authentification --------------------------------------------------
# otp (defaut, sur) : code a 6 chiffres verifie avant connexion.
# phone_only : AUCUNE verification, connexion instantanee avec le numero
#              tape. Decision produit temporaire (voir README, section
#              "Mode sans verification") — a repasser sur "otp" des que
#              possible. Le second facteur admin (ADMIN_ACCESS_CODE) reste
#              actif independamment, /admin n'est pas affaibli.
AUTH_MODE=otp

# Transport du code OTP (ignore si AUTH_MODE=phone_only) :
# console : le code s'affiche dans les logs serveur (et dans le navigateur en dev).
#           Utile pour tester en prive avant l'ouverture au public.
# twilio  : envoi reel par SMS ou WhatsApp via Twilio (voir plus bas).
# http    : POST { to, message } vers OTP_HTTP_URL (branche n'importe quelle autre passerelle).
OTP_TRANSPORT=console
OTP_HTTP_URL=
OTP_HTTP_TOKEN=

# Twilio — https://console.twilio.com (essai gratuit disponible)
# TWILIO_FROM_NUMBER : ton numero Twilio pour le SMS (ex: +15017122661),
# ou le numero WhatsApp fourni par Twilio si TWILIO_CHANNEL=whatsapp.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optionnel : si tu utilises une "API Key" Twilio (SID commencant par "SK")
# plutot que l'Auth Token classique, mets son SID ici et son "Client secret"
# dans TWILIO_AUTH_TOKEN ci-dessus.
TWILIO_API_KEY_SID=
TWILIO_FROM_NUMBER=
TWILIO_CHANNEL=sms

# Cloudflare Turnstile (anti-robot sur la demande de code OTP), optionnel.
# Cle gratuite sur https://dash.cloudflare.com/?to=/:account/turnstile
# Vide = le widget ne s'affiche jamais (comportement actuel, inchange).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Paiement --------------------------------------------------------------
# simulation : aucun agregateur reel, pour developper/tester le parcours complet.
# cinetpay / ligdicash : agregateurs mobile money actifs pour le Burkina Faso.
PAYMENT_PROVIDER=simulation
MANUAL_PAYMENT_ENABLED=true

# CinetPay — https://cinetpay.com
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# LigdiCash — https://ligdicash.com
LIGDICASH_API_KEY=
LIGDICASH_API_TOKEN=

# Numeros marchands pour le paiement manuel (depot + reference collee par le client).
# Laisse vide les operateurs que tu n'utilises pas.
MM_ORANGE_NUMBER=
MM_MOOV_NUMBER=
MM_TELECEL_NUMBER=
MM_WAVE_NUMBER=
